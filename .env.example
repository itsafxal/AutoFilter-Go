# ==========================================
# Telegram MTProto & Bot Configuration (Gogram)
# ==========================================

# Required: Telegram API ID obtained from https://my.telegram.org
# Example: 1234567
API_ID=your_api_id_here

# Required: Telegram API Hash obtained from https://my.telegram.org
# Example: 0123456789abcdef0123456789abcdef
API_HASH=your_api_hash_here

# Required: Telegram Bot Token obtained from @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=your_bot_token_here

# Required: Numeric Telegram User ID of the primary bot owner
# Example: 123456789
OWNER_ID=your_owner_id_here

# Optional: Comma- or space-separated list of additional admin Telegram User IDs
# Note: OWNER_ID is automatically granted admin privileges regardless.
# Example: 123456789,987654321
ADMINS=123456789,987654321

# Optional: Session file storage path (Default: session.dat)
# Note: Session files must never be committed to Git or baked into Docker images.
SESSION_PATH=session.dat

# Optional: Whether to use in-memory session without writing to disk (Default: false)
MEMORY_SESSION=false

# Optional: Application logging verbosity (DEBUG, INFO, WARN, ERROR)
# Default: INFO
LOG_LEVEL=INFO

# ==========================================
# Primary Database: Authoritative MongoDB
# ==========================================

# Required for database persistence: MongoDB connection URI
# Example: mongodb+srv://username:password@cluster0.abc.mongodb.net/?retryWrites=true&w=majority
DATABASE_URI=your_mongodb_connection_uri_here

# Optional: Authoritative database name (Default: CyberTG)
DATABASE_NAME=CyberTG

# Optional: Media collection name (Default: Telegram-Document)
COLLECTION_NAME=Telegram-Document

# Optional: Secondary MongoDB cluster URI (defaults to DATABASE_URI if omitted)
DATABASE_URI2=

# Optional: Tertiary MongoDB cluster URI (defaults to DATABASE_URI if omitted)
DATABASE_URI3=

# ==========================================
# Temporary SQL Database: Auto-Filter Runtime
# ==========================================

# Optional: Path for the local runtime SQLite database cache (Default: media.sqlite3)
SQLITE_DB_PATH=media.sqlite3

# Optional: Number of documents to batch during synchronization (Default: 10000)
SYNC_BATCH_SIZE=10000

# ==========================================
# Media Delivery & Custom Caption Settings
# ==========================================

# Optional: Default media file custom caption template
# Supported Placeholders: {filename}, {file sise}, {filesize}, {file size}, {size}, {caption}
# Default: CUSTOM CAPTION {filename} {file sise}
CUSTOM_CAPTION=CUSTOM CAPTION {filename} {file sise}

# ==========================================
# Force Subscribe Settings
# ==========================================

# Optional: Default channel description set automatically when a channel is added to FSub
# Default: You need to request to join channel to get file 🚀
FSUB_CHANNEL_DESCRIPTION=You need to request to join channel to get file 🚀

# ==========================================
# Auto-Delete & Weekly Trash Settings
# ==========================================

# Optional: Duration before search filter result messages are auto-deleted
# Format: 10m, 15m, 30m, 1h, or 0 to disable (Default: 15m)
AUTO_DELETE_FILTER_TIME=15m

# Optional: Duration before delivered file messages are auto-deleted
# Format: 15m, 30m, 1h, 2h, or 0 to disable (Default: 30m)
AUTO_DELETE_FILE_TIME=30m

# Optional: Whether weekly trash cleanup is enabled to avoid copyright strikes (Default: true)
AUTO_DELETE_WEEKLY_TRASH=true

# Optional: Number of days before sent messages are permanently purged by weekly trash (Default: 7)
TRASH_RETENTION_DAYS=7

# ==========================================
# File-to-Link, Stream & Fast Download Settings
# ==========================================

# Optional: Enable the HTTP Streaming & Fast Download web server (Default: true)
STREAM_SERVER_ENABLED=true

# Optional: Public base URL for stream and fast download links (used in Telegram buttons)
# Example: http://your-vps-ip:8080 or https://stream.example.com
# Default: http://localhost:8080
STREAM_URL=http://localhost:8080

# Optional: Port for the streaming server to bind and listen on (Default: 8080 or PORT env)
STREAM_PORT=8080

# Optional: Host/IP interface for the stream server to bind on (Default: 0.0.0.0)
STREAM_BIND_ADDR=0.0.0.0

# Optional: Dedicated Telegram Bot Token for high-speed streaming downloads.
# If specified, streaming and fast downloads use this dedicated bot instance to prevent
# slowing down or rate-limiting your primary bot. If empty, uses the primary BOT_TOKEN.
STREAM_BOT_TOKEN=

# Optional: Whether to append the "⚡ Get Fast Download" button to delivered media messages (Default: true)
ENABLE_FAST_DOWNLOAD_BUTTON=true



