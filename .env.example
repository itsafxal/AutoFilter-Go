# ==============================================================================
# PRIMARY BOT CREDENTIALS & ACCESS (Required)
# ==============================================================================

# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram MTProto API credentials obtained from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telegram User ID of the primary bot owner
OWNER_ID=your_owner_id_here

# Comma- or space-separated list of admin Telegram User IDs (OWNER_ID is automatically included)
ADMINS=your_owner_id_here,additional_admin_id

# Channels monitored for automatic live media indexing (comma- or space-separated)
# Accepts channel IDs (-1001234567890 or 1234567890)
CHANNELS=-1001234567890

# ==============================================================================
# OLD BOTS USER MIGRATION (Optional)
# ==============================================================================
# Run old bots concurrently in background to migrate/funnel users into your main bot.
# Old bots respond to /start and search queries with instant deep-link buttons redirecting to your main bot.
# Specify comma-separated tokens in OLD_BOT_TOKENS, or set OLD_BOT_TOKEN_1 and OLD_BOT_TOKEN_2 individually.
# OLD_BOT_TOKENS=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11,987654:XYZ-UVW9876abCde-rqp54N3m2l987po33
# OLD_BOT_TOKEN_1=
# OLD_BOT_TOKEN_2=

# ==============================================================================
# AUTHORITATIVE MONGODB CLUSTERS (Sharded Storage)
# ==============================================================================

# Primary Database: Dedicated exclusively to Users, Groups, and Authentication
DATABASE_URI=your_primary_mongodb_uri_here
DATABASE_NAME=CyberTG
COLLECTION_NAME=Telegram-Document

# Media Database 1 (DB2): Secondary MongoDB cluster for media storage
DATABASE_URI2=your_media_db2_uri_here

# Media Database 2 (DB3): Tertiary MongoDB cluster for media storage
DATABASE_URI3=your_media_db3_uri_here

# ==============================================================================
# OPTIONAL / FEATURE TOGGLES & ADVANCED SETTINGS (Defaults provided)
# ==============================================================================

# HTTP Streaming & Fast Download Server Settings
STREAM_SERVER_ENABLED=true
STREAM_URL=http://localhost:8080
STREAM_PORT=8080
STREAM_BIND_ADDR=0.0.0.0
ENABLE_FAST_DOWNLOAD_BUTTON=true
FAST_DOWNLOAD_BUTTON_STYLE=green # green (default, Success) or blue (Primary)

# Auto-Delete & Weekly Trash Cleanup
AUTO_DELETE_WEEKLY_TRASH=true
TRASH_RETENTION_DAYS=7
AUTO_DELETE_FILTER_TIME=15m
AUTO_DELETE_FILE_TIME=30m
AUTO_DELETE_FAST_DOWNLOAD_TIME=5m
FAST_DOWNLOAD_LINK_EXPIRY=30m

# Media Delivery & Captions
CUSTOM_CAPTION={filename}\n\nFile Size : {file size}
FSUB_CHANNEL_DESCRIPTION=You need to request to join channel to get file 🚀
START_PIC=assets/start.jpg

# Maintenance Mode (When true, only admins can search/get results in groups & PM; others only have /start access)
MAINTENANCE_MODE=false

# Search Results & Interface Premium Custom Emojis (Telegram Premium MTProto icons & HTML entities)
ENABLE_PREMIUM_EMOJI=true
PREV_BUTTON_EMOJI_ID=5469982030773120950
NEXT_BUTTON_EMOJI_ID=5469715085670772857
PAGE_BUTTON_EMOJI_ID=5837048052061311256
QUALITY_BUTTON_EMOJI_ID=5276251908774858442
LANGUAGE_BUTTON_EMOJI_ID=5276011261757265100
MULTI_LANG_BUTTON_EMOJI_ID=5256169350368353876
SELECT_LANGUAGE_EMOJI_ID=5447410659077661506
SELECT_QUALITY_EMOJI_ID=5334544901428229844
FAST_DOWNLOAD_BUTTON_EMOJI_ID=6156513311585211842
GREETING_PREFIX_EMOJI_ID=5472055112702629499
GREETING_EMOJI_ID=5427232022252764138
QUERY_EMOJI_ID=5190859184312167965
PAGE_TEXT_EMOJI_ID=5836954069586946866
NOTE_PREFIX_EMOJI_ID=4956461073550017373
NOTE_SUFFIX_EMOJI_ID=4958724224962265918
NOTE_EXPIRE_EMOJI_ID=5440660757194744323
BOT_NAME_EMOJI_ID=6104631352190043951
FILE_SIZE_PREFIX_EMOJI_ID=5992513524440502236
FILE_SIZE_SUFFIX_EMOJI_ID=5992519984071315160

# SQLite Runtime Cache & Synchronization Settings
# Set ENABLE_SYNC=false if you want zero SQLite sync (queries MongoDB directly, boots in 1s, uses ~50MB RAM)
ENABLE_SYNC=true
BACKGROUND_SYNC=true
SYNC_BATCH_SIZE=1500
SQLITE_DB_PATH=media.sqlite3

# VPS Resource & Memory Optimization Settings (Crucial for 1GB - 2GB RAM / 1-2 vCPU VPS)
# GOMEMLIMIT: Hard soft-limit for Go heap to trigger aggressive GC before VPS runs out of RAM
GOMEMLIMIT=512MiB
# GOGC: Garbage collection target percentage (lower = more frequent GC, less RAM used)
GOGC=60
# MAX_MEMORY_MB: Alternative memory limit in megabytes if GOMEMLIMIT is not set (default: 512)
MAX_MEMORY_MB=512
# MAX_CPU_CORES: Max CPU threads to use (set to 1 on single-core budget VPS to prevent 100% CPU lock)
# MAX_CPU_CORES=1

# Fast Broadcast Engine Concurrency (Bounded worker pool; default: 10, recommended: 5-20)
BROADCAST_CONCURRENCY=10

# Bot Lifecycle & Group Welcome Configuration
ENABLE_GROUP_WELCOME=true
WELCOME_DELETE_DELAY=0
REPO_URL=https://github.com/itsafxal/AutoFilter-Go

# General Logging & Session Storage
LOG_LEVEL=INFO
SESSION_PATH=bot.session
MEMORY_SESSION=false
