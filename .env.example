# ==========================================
# Telegram Bot Configuration
# ==========================================

# Required: Telegram Bot API Token obtained from @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=your_bot_token_here

# Required: Numeric Telegram User ID of the primary bot owner
# Example: 123456789
OWNER_ID=your_owner_id_here

# Optional: Comma- or space-separated list of additional admin Telegram User IDs
# Note: OWNER_ID is automatically granted admin privileges regardless.
# Example: 123456789,987654321
ADMINS=123456789,987654321

# Optional: Application logging verbosity (DEBUG, INFO, WARN, ERROR)
# Default: INFO
LOG_LEVEL=INFO

# ==========================================
# Primary Database: Authoritative MongoDB
# ==========================================

# Required for database persistence: MongoDB connection URI
# Example: mongodb+srv://username:password@cluster0.abc.mongodb.net/?retryWrites=true&w=majority
DATABASE_URI=your_mongodb_connection_uri_here

# Optional: Authoritative database name (Default: CyberTG)
DATABASE_NAME=CyberTG

# Optional: Media collection name (Default: Telegram-Document)
COLLECTION_NAME=Telegram-Document

# Optional: Secondary MongoDB cluster URI (defaults to DATABASE_URI if omitted)
DATABASE_URI2=

# Optional: Tertiary MongoDB cluster URI (defaults to DATABASE_URI if omitted)
DATABASE_URI3=

# ==========================================
# Temporary SQL Database: Auto-Filter Runtime
# ==========================================

# Optional: Path for the local runtime SQLite database cache (Default: media.sqlite3)
SQLITE_DB_PATH=media.sqlite3

# Optional: Number of documents to batch during synchronization (Default: 10000)
SYNC_BATCH_SIZE=10000
